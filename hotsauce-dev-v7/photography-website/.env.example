# Contact form — copy this file to .env.local and fill in the real values.
# .env.local is gitignored; never commit a real API key.

# Get one at https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered.
CONTACT_TO_EMAIL=maryfdenman@gmail.com

# Who they appear to come from. Resend only delivers from a domain you have
# verified. Until the site's domain is verified, leave this as the Resend
# sandbox address below — it will only deliver to the Resend account owner.
CONTACT_FROM_EMAIL=onboarding@resend.dev
